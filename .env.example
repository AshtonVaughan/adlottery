# Brand
NEXT_PUBLIC_APP_NAME="The Weekly Pot"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_SPONSOR_CONTACT=sponsors@example.com

# Money: share of gross ad revenue that goes into the pot (shown publicly)
NEXT_PUBLIC_AD_SHARE_PERCENT=50

# Countries that can't enter (ISO codes). Have counsel review this list.
NEXT_PUBLIC_EXCLUDED_COUNTRIES=CU,IR,KP,SY,RU,BY

# Supabase (leave empty to run in demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated admin emails
ADMIN_EMAILS=

# Vercel Cron sends this as a bearer token to /api/cron/lifecycle
CRON_SECRET=

# Ads (Google AdSense). Empty = placeholder boxes.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Winner emails via Resend (optional; skipped when empty)
RESEND_API_KEY=
EMAIL_FROM="The Weekly Pot <no-reply@yourdomain.com>"
