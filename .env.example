# Copy to .env.local for local development. Everything prefixed
# NEXT_PUBLIC_ is baked into the static site and is public.

NEXT_PUBLIC_APP_NAME="The Weekly Pot"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_SPONSOR_CONTACT=sponsors@example.com
NEXT_PUBLIC_AD_SHARE_PERCENT=50
NEXT_PUBLIC_EXCLUDED_COUNTRIES=CU,IR,KP,SY,RU,BY

# Supabase (public anon key). Leave empty for demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AdSense. Empty = placeholder boxes.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Only for `npm run lifecycle` (the hourly job). Never expose these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
RESEND_API_KEY=
EMAIL_FROM="The Weekly Pot <no-reply@yourdomain.com>"
